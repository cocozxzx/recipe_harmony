const DEBOUNCE_MS = 300;
let DetailViewModel = class DetailViewModel {
    constructor() {
        this.state = new PageState();
        this.detail = null;
        this.servings = 1;
        this.favorited = false;
        this.liked = false;
        this.favoriteCount = 0;
