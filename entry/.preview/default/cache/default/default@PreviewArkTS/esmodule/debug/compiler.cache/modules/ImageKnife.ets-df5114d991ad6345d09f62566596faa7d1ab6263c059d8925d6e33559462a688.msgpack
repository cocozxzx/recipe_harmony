     * @returns æ˜¯å¦åˆå§‹åŒ–
     */
    isFileCacheInit() {
        return this.fileCache === undefined ? false : this.fileCache.isFileCacheInit();
    }
    /**
     * é‡æ–°åŠ è½½
     */
    reload(request) {
