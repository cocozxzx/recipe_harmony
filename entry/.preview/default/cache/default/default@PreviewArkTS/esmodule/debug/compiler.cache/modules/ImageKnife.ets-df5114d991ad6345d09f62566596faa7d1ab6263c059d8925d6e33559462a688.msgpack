  async initFileCache(context: Context, size: number = 256, memory: number = 256 * 1024 * 1024, path?: string) {
    this.fileCache = new FileCache(context, size, memory)
    try {
      if (path != undefined) {
        await this.fileCache.initFileCache(path)
